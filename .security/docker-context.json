{
  "format": 1,
  "patterns": [
    "**",
    "!Dockerfile",
    "!.dockerignore",
    "!.npmrc",
    "!package.json",
    "!package-lock.json",
    "!tsconfig.json",
    "!tsconfig.plugins.json",
    "!nest-cli.json",
    "!gateway.config.example.yaml",
    "!src/**",
    "!plugins/**",
    "!scripts/copy-runtime-assets.js",
    "!scripts/docker-healthcheck.js",
    "!frontend/.npmrc",
    "!frontend/package.json",
    "!frontend/package-lock.json",
    "!frontend/index.html",
    "!frontend/tsconfig.json",
    "!frontend/tsconfig.app.json",
    "!frontend/tsconfig.node.json",
    "!frontend/vite.config.ts",
    "!frontend/src/**",
    "!frontend/public/**",
    "!frontend/scripts/check-bundle-budget.mjs",
    "**/node_modules",
    "**/.git",
    "**/.env",
    "**/.env.*",
    "**/gateway.config.yaml",
    "**/gateway.config.yaml.*",
    "**/catalog.override.yaml",
    "**/*.db",
    "**/*.db-*",
    "**/*.sqlite*",
    "**/*.pem",
    "**/*.key",
    "**/*.log",
    "**/*.bak",
    "**/*.bak-*",
    "**/__pycache__",
    "**/*.py[cod]",
    "**/.DS_Store",
    "**/.claude",
    "**/.siftgate",
    "**/.local-dev",
    "**/output"
  ],
  "copy_instructions": [
    "COPY frontend/package.json frontend/package-lock.json ./",
    "COPY frontend/.npmrc ./",
    "COPY frontend/ ./",
    "COPY src/ /app/src/",
    "COPY package.json package-lock.json ./",
    "COPY .npmrc ./",
    "COPY tsconfig.json nest-cli.json ./",
    "COPY src/ ./src/",
    "COPY plugins/ ./plugins/",
    "COPY tsconfig.plugins.json ./",
    "COPY scripts/copy-runtime-assets.js ./scripts/copy-runtime-assets.js",
    "COPY package.json package-lock.json ./",
    "COPY .npmrc ./",
    "COPY --from=backend-build /app/dist ./dist",
    "COPY --from=backend-build /app/dist-runtime-plugins ./dist-runtime-plugins",
    "COPY --from=frontend-build /app/frontend/dist ./frontend/dist",
    "COPY gateway.config.example.yaml ./gateway.config.yaml",
    "COPY scripts/docker-healthcheck.js ./scripts/docker-healthcheck.js"
  ],
  "allowed_sentinels": [
    "package.json",
    "package-lock.json",
    ".npmrc",
    "tsconfig.json",
    "tsconfig.plugins.json",
    "nest-cli.json",
    "gateway.config.example.yaml",
    "src/main.ts",
    "plugins/fixture/index.ts",
    "scripts/copy-runtime-assets.js",
    "scripts/docker-healthcheck.js",
    "frontend/.npmrc",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/index.html",
    "frontend/tsconfig.json",
    "frontend/tsconfig.app.json",
    "frontend/tsconfig.node.json",
    "frontend/vite.config.ts",
    "frontend/src/main.tsx",
    "frontend/public/favicon.svg",
    "frontend/scripts/check-bundle-budget.mjs"
  ],
  "denied_sentinels": [
    "gateway.config.yaml",
    "gateway.config.yaml.bak-secret",
    "gateway.config.yaml.backup",
    ".env",
    ".env.local",
    "catalog.override.yaml",
    ".npmrc.backup",
    "output/fixture.yaml",
    ".claude/settings.json",
    ".siftgate/backup.yaml",
    ".local-dev/report.json",
    "siftgate-cloud/private.ts",
    "CLOUD_DEVELOPMENT_PLAN.md",
    "private-records/report.md",
    "archive.bundle",
    "docs/private.md",
    ".git/config",
    "data/gateway.db",
    "node_modules/example/index.js",
    "frontend/node_modules/example/index.js",
    "frontend/dist/index.html",
    "frontend/sample.png",
    "frontend/.env.production",
    "frontend/src/.env.local",
    "src/secret.key",
    "plugins/fixture/private.pem",
    "src/config/gateway.config.yaml",
    "src/config/gateway.config.yaml.bak-secret",
    "src/output/secret.json",
    "src/.siftgate/backup.yaml",
    "src/database.sqlite-wal",
    "src/secret.log",
    "frontend/public/.DS_Store"
  ]
}
